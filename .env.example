# Copy to .env and adjust. Every setting in person_search/config.py can be set
# here with the PS_ prefix and __ for nesting.

# Profile with the paths and thresholds (lowest priority after code defaults)
PS_CONFIG_FILE=configs/report_run.yaml

PS_DEVICE=cpu
# PS_TORCH_THREADS=4

# PS_DETECTOR__WEIGHTS=models/yolo11n_person.pt
# PS_OSNET__WEIGHTS=models/osnet_campus_v1.pth.tar
# PS_IRRA__WEIGHTS=models/irra_v1.pth
# PS_SCORING__BASE_THRESHOLD=0.65

# Web API (make serve)
# PS_API__INDEX_PATH=data/index
# PS_API__UPLOAD_DIR=data/uploads
# PS_API__MAX_VIDEO_MB=500
# PS_API__MAX_PENDING_JOBS=4
# Set on the public Space (decision 0015): POST /ingest then needs X-API-Key
# PS_API__API_KEY=<openssl rand -hex 24>

# Docker / `person-search serve`: where missing weights and the index download from
# PS_ASSETS__REPO=<hf-user>/person-search-assets
# PS_ASSETS__REVISION=<commit printed by make publish-assets>

# Tests: where the legacy checkouts and test cases live
# PS_LEGACY_ROOT=../legacy
# PS_CASES_DIR=../legacy/amrit-pbvs

# Hugging Face token (private gate-set dataset, Day 8)
# HF_TOKEN=
